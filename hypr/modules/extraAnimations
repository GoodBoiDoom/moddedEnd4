# ============================================
# PRESET 7: GAMING/PERFORMANCE
# ============================================
# Very fast animations, minimal overhead
# Best for: Gaming, low-spec hardware
animations {
    enabled = yes
    bezier = gaming, 0.4, 0, 0.2, 1
    
    animation = windows, 1, 2, gaming, slide
    animation = windowsOut, 1, 1.5, gaming, slide
    animation = border, 1, 3, gaming
    animation = fade, 1, 2, gaming
