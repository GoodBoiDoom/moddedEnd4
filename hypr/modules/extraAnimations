# ============================================
# HYPRLAND ANIMATION CONFIGURATIONS
# ============================================
# Copy the animation block you like into your hyprland.conf
# Test changes with: hyprctl reload


# ============================================
# YOUR CURRENT CONFIG (SMOOTHED)
# ============================================

#default
animations {
    enabled = yes

    bezier = wind, 0.05, 0.9, 0.1, 1.05
    bezier = winIn, 0.1, 1.1, 0.1, 1.1
    bezier = winOut, 0.3, -0.3, 0, 1
    bezier = linear, 1, 1, 1, 1

    animation = windows, 1, 1, wind, slide
    animation = windowsIn, 1, 1, winIn, slide
    animation = windowsOut, 1, 1, winOut, slide
    animation = workspaces, 1, 2.5, wind
    animation = border, 1, 1, linear
    animation = borderangle, 1, 30, linear, loop
    animation = fade, 1, 4, default
}

# Increased durations for smoother motion
animations {
    enabled = yes
    bezier = wind, 0.05, 0.9, 0.1, 1.05
    bezier = winIn, 0.1, 1.1, 0.1, 1.1
    bezier = winOut, 0.3, -0.3, 0, 1
    bezier = linear, 1, 1, 1, 1
    
    animation = windows, 1, 4, wind, slide         # increased from 1 to 4
    animation = windowsIn, 1, 4, winIn, slide      # increased from 1 to 4
    animation = windowsOut, 1, 3, winOut, slide    # increased from 1 to 3
    animation = workspaces, 1, 5, wind             # increased from 2.5 to 5
    animation = border, 1, 10, linear              # increased from 1 to 10
    animation = borderangle, 1, 50, linear, loop   # increased from 30 to 50
    animation = fade, 1, 7, default                # increased from 4 to 7
}


# ============================================
# PRESET 1: BUTTERY SMOOTH (macOS-like)
# ============================================
# Smooth, elegant animations with subtle overshot
# Best for: Users who want polished, professional feel
animations {
    enabled = yes
    bezier = smoothOut, 0.36, 0, 0.66, -0.56
    bezier = smoothIn, 0.25, 1, 0.5, 1
    bezier = overshot, 0.05, 0.9, 0.1, 1.1
    
    animation = windows, 1, 5, overshot, slide
    animation = windowsOut, 1, 4, smoothOut, slide
    animation = border, 1, 10, default
    animation = fade, 1, 8, smoothIn
    animation = fadeDim, 1, 8, smoothIn
    animation = workspaces, 1, 6, overshot, slidevert
}


# ============================================
# PRESET 2: SNAPPY & RESPONSIVE
# ============================================
# Quick, efficient animations with popin effect
# Best for: Fast-paced workflows, productivity focus
animations {
    enabled = yes
    bezier = fast, 0.1, 0.9, 0.1, 1.0
    bezier = quick, 0.23, 1, 0.32, 1
    
    animation = windows, 1, 3, quick, popin 80%
    animation = windowsOut, 1, 2, fast, popin 80%
    animation = border, 1, 5, default
    animation = fade, 1, 4, quick
    animation = workspaces, 1, 4, quick, slide
}


# ============================================
# PRESET 3: ELEGANT & FLOATY
# ============================================
# Slow, graceful animations with extended easing
# Best for: Aesthetic-focused setups, presentations
animations {
    enabled = yes
    bezier = easeOutQuart, 0.25, 1, 0.5, 1
    bezier = easeInOutCirc, 0.85, 0, 0.15, 1
    bezier = easeOutExpo, 0.16, 1, 0.3, 1
    
    animation = windows, 1, 6, easeOutExpo, popin 60%
    animation = windowsMove, 1, 5, easeOutQuart, slide
    animation = fade, 1, 8, easeOutQuart
    animation = workspaces, 1, 7, easeOutExpo, slide
    animation = specialWorkspace, 1, 6, easeInOutCirc, slidevert
}


# ============================================
# PRESET 4: MINIMAL MOTION
# ============================================
# Subtle animations for reduced motion preference
# Best for: Performance optimization, motion sensitivity
animations {
    enabled = yes
    bezier = simple, 0.5, 0, 0.5, 1
    
    animation = windows, 1, 2, simple, fade
    animation = windowsOut, 1, 2, simple, fade
    animation = border, 1, 3, simple
    animation = fade, 1, 3, simple
    animation = workspaces, 1, 3, simple, fade
}


# ============================================
# PRESET 5: BOUNCY & PLAYFUL
