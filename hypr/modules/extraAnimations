    enabled = yes
    bezier = ultra, 0.16, 1, 0.3, 1
    bezier = silk, 0.25, 0.46, 0.45, 0.94
    
    animation = windows, 1, 8, ultra, slide
    animation = windowsOut, 1, 6, silk, slide
    animation = border, 1, 15, default
